{
  "meta": {
    "generatedAt": "2026-08-18",
    "sources": [
      "wger.de REST API v2 — GET /api/v2/exerciseinfo/?language=4&limit=100 (paginated), GET /api/v2/exercisecategory/, GET /api/v2/equipment/ (name -> Spanish translation, muscleGroup/equipmentType)",
      "github.com/yuhonas/free-exercise-db dist/exercises.json — mechanic field (compound/isolation), cross-referenced by normalized name match, used to resolve movementType (not provided by wger)"
    ],
    "rawWgerExerciseCount": 873,
    "curatedCount": 95,
    "curationCriteria": "Filtered wger exerciseinfo results (Cardio category excluded — not weight/rep based) by a whitelist of standard strength-training movement keywords (squat, press, row, curl, extension, raise, pulldown, deadlift, etc.), then hand-picked ~95 exercises to give full coverage of all 7 strength muscle groups (Legs, Back, Chest, Shoulders, Arms, Abs, Calves) across the most common equipment types (barbell, dumbbell, machine, cable/pulley, bodyweight, pull-up bar, EZ-bar), preferring one clean canonical name per movement pattern over near-duplicate variants.",
    "movementTypeResolution": "Primary: normalized-name match against free-exercise-db mechanic field (compound/isolation), used for ~33% of entries. Fallback heuristic for the rest (no confident match): exercise name containing single-joint keywords (curl, extension, raise, fly, kickback, shrug, adduction, abduction, crossover) => ISOLATION; name containing multi-joint keywords (squat, deadlift, press, row, pull-up, dip, clean, snatch, thruster, lunge, step-up, good morning, hip thrust, pulldown, pullover) => COMPOUND; otherwise defaults to ISOLATION. One manual override: Cable Curls (free-exercise-db mis-tags the closest match, High Cable Curls, as compound; a single-joint elbow-flexion curl is isolation by convention).",
    "spanishTranslationCoverage": "644/873 (73.8%) wger exercises have an official Spanish (language=4) translation. Entries without one fall back to the English name — flagged via _source.nameFallbackToEnglish in this file (4/95 in the curated set: Stiff-legged Deadlifts, Dumbbell Split Squat, Face Pulls (Bodyweight Doorframe/Towel), Cable Curls).",
    "equipmentDataQuality": "wger equipment tags are user-submitted and frequently empty/incomplete even for well-known machine exercises (e.g. Leg Press, Hack Squat, Lat Pulldown, Chest Press Machine came back with an empty equipment array). For entries where the tag was empty or clearly wrong, equipmentType was manually corrected based on common gym knowledge — flagged via _source.equipmentOverridden.",
    "license": "Exercise names sourced from wger.de, CC-BY-SA 4.0 (https://creativecommons.org/licenses/by-sa/4.0/). movementType cross-referenced from free-exercise-db (Unlicense/public domain).",
    "note": "_source fields are provenance metadata for maintainers only (wger id, original English name, how movementType/equipmentType were resolved) — not written to the database. The Exercise model intentionally has no externalId column (YAGNI for this one-off seed); re-syncing later means re-running the fetch+curation script and re-generating this file."
  },
